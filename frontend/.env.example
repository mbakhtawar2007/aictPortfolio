# Frontend env — PLACEHOLDERS ONLY. Set real values at Netlify build time.
# NEXT_PUBLIC_API_URL must point at the Vercel backend, e.g.
# https://YOUR-VERCEL-PROJECT.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:4001/api
# Firebase WEB config (public config, NOT secrets — still keep in env, not hardcoded).
# Used only for signInWithEmailAndPassword for EXISTING accounts.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

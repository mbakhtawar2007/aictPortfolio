# Backend env vars — PLACEHOLDERS ONLY. Never put a real secret here.
# Set real values in Vercel Project Settings > Environment Variables.
PORT=4001
CORS_ORIGIN=http://localhost:3000
# Firebase: set FIREBASE_ENABLED=true only when a real project exists.
FIREBASE_ENABLED=false
# DEMO_MODE=true allows the documented local test tokens ONLY for local
# verification. NEVER set DEMO_MODE=true in production / Vercel.
DEMO_MODE=false
# One of these, server-only, never NEXT_PUBLIC_:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID"}
# ...or a file path on the server:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Cloudinary (free, no card) — entered by the user in Vercel, not here.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
# Resend (optional, contact notifications only)
RESEND_API_KEY=YOUR_RESEND_API_KEY
CONTACT_NOTIFY_EMAIL=admin@example.com
# First-admin bootstrap only (backend/scripts/bootstrap-admin.js)
BOOTSTRAP_TOKEN=YOUR_ONE_TIME_BOOTSTRAP_TOKEN
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=First Admin

# Base URL used to build invitation links (default is the Netlify site).
# Leave empty to use the default:
PUBLIC_SITE_URL=

# Automatic invitation email via the admin's own Gmail (no third-party email service).
# Requires 2-Step Verification on that Google account, then an App Password
# (Google Account → Security → App passwords → Mail). Never share it in chat.
# When these are set, invite links are emailed automatically on creation.
GMAIL_USER=
GMAIL_APP_PASSWORD=
